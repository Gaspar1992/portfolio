{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:ssg": "ng build --configuration production --prerender",
    "build:prod": "ng build --configuration production --base-href /portfolio/",
    "build:compressed": "ng build --configuration production --base-href /portfolio/ && node scripts/compress-assets.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ci": "playwright test --project=chromium",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --fix",
    "lint:html": "eslint 'src/**/*.html'",
    "lint:html:fix": "eslint 'src/**/*.html' --fix",
    "lint:all": "npm run lint && npm run lint:html",
    "lint:all:fix": "npm run lint:fix && npm run lint:html:fix",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check": "biome check .",
    "check:fix": "biome check . --fix",
    "import:linkedin": "node scripts/import-linkedin-export.mjs",
    "cv": "node scripts/generate-cv-pdf.mjs",
    "compress": "node scripts/compress-assets.mjs",
    "optimize:photo": "node scripts/optimize-profile-photo.mjs",
    "lighthouse": "lhci autorun",
    "lighthouse:desktop": "lighthouse http://localhost:4200 --output=html --output-path=./lighthouse-report.html --config-path=./lighthouse.config.js",
    "lighthouse:mobile": "lighthouse http://localhost:4200 --output=html --output-path=./lighthouse-report-mobile.html --config-path=./lighthouse.config.js --emulated-form-factor=mobile",
    "lighthouse:ci": "npm run build:prod && lhci autorun --config=lighthouserc.js",
    "predeploy": "npm run lint:all && npm run test",
    "deploy:check": "npm run predeploy && npm run lighthouse:ci",
    "quality:check": "npm run predeploy",
    "serve:ssr:portfolio": "node dist/portfolio/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.13",
    "@angular/compiler": "^21.2.13",
    "@angular/core": "^21.2.13",
    "@angular/forms": "^21.2.13",
    "@angular/platform-browser": "^21.2.13",
    "@angular/platform-server": "^21.2.13",
    "@angular/router": "^21.2.13",
    "@angular/ssr": "^21.2.11",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.13",
    "@biomejs/biome": "^2.4.9",
    "@html-eslint/eslint-plugin": "^0.59.0",
    "@html-eslint/parser": "^0.59.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "jsdom": "^29.0.2",
    "lighthouse": "^13.1.0",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  }
}
