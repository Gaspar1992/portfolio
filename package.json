{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:ssg": "ng build --configuration production",
    "build:prod": "ng build --configuration production --base-href /portfolio/",
    "build:compressed": "ng build --configuration production --base-href /portfolio/ && node scripts/compress-assets.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ci": "playwright test --project=chromium",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --fix",
    "lint:html": "eslint 'src/**/*.html'",
    "lint:html:fix": "eslint 'src/**/*.html' --fix",
    "lint:all": "npm run lint && npm run lint:html",
    "lint:all:fix": "npm run lint:fix && npm run lint:html:fix",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check": "biome check .",
    "check:fix": "biome check . --fix",
    "import:linkedin": "node scripts/import-linkedin-export.mjs",
    "cv": "node scripts/generate-cv-pdf.mjs",
    "compress": "node scripts/compress-assets.mjs",
    "optimize:photo": "node scripts/optimize-profile-photo.mjs",
    "lighthouse": "lhci autorun",
    "lighthouse:desktop": "lighthouse http://localhost:4200 --output=html --output-path=./lighthouse-report.html --config-path=./lighthouse.config.js",
    "lighthouse:mobile": "lighthouse http://localhost:4200 --output=html --output-path=./lighthouse-report-mobile.html --config-path=./lighthouse.config.js --emulated-form-factor=mobile",
    "lighthouse:ci": "npm run build:prod && lhci autorun --config=lighthouserc.js",
    "predeploy": "npm run lint:all && npm run test",
    "deploy:check": "npm run predeploy && npm run lighthouse:ci",
    "quality:check": "npm run predeploy"
  },
  "private": true,
  "packageManager": "pnpm@11.2.0+sha512.cdd7e34ea0d237bed3fa89e633185027e3ecdad98ce7453032f4d4d83c10cb7b85b9afe8534048ab0a3cc10228bdd5e32f5f622d05d66e58f46177fe5601eab1",
  "dependencies": {
    "@angular-helpers/core": "^22.4.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@biomejs/biome": "^2.5.8",
    "@html-eslint/eslint-plugin": "^0.64.0",
    "@html-eslint/parser": "^0.64.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
